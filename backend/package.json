    "helmet": "^7.1.0",
    "pino": "^8.17.0",
    "pino-pretty": "^10.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "tsx": "^4.7.0",
    "vitest": "^1.4.0",
    "supertest": "^6.3.0",
    "eslint": "^8.57.0"
  }
